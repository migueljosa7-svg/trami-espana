# ===========================================
# TRAMI ESPAÑA - Variables de Entorno
# ===========================================
# Copia este archivo a .env y completa con tus valores
# ===========================================

# -------------------------------------------
# Supabase Configuration (Web)
# -------------------------------------------
# Usa la URL y anon key de tu proyecto Supabase.
# La anon key es pública por diseño; NUNCA uses la service_role key en el frontend.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# -------------------------------------------
# Supabase Configuration (Mobile)
# -------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# -------------------------------------------
# Application Configuration
# -------------------------------------------
VITE_APP_NAME=Trami España
# VITE_APP_URL=http://localhost:5173
VITE_APP_VERSION=1.0.0

# -------------------------------------------
# Analytics (Opcional - para fases futuras)
# -------------------------------------------
# VITE_ANALYTICS_ID=tu-analytics-id

# -------------------------------------------
# AI Service (Opcional - para fases futuras)
# -------------------------------------------
# VITE_AI_API_URL=https://tu-api-ia.com
# VITE_AI_API_KEY=tu-api-key-ia

# -------------------------------------------
# Contact Form (Opcional)
# -------------------------------------------
# VITE_CONTACT_EMAIL=contacto@tramiespana.es

# -------------------------------------------
# Feature Flags
# -------------------------------------------
# VITE_ENABLE_ASSISTANT=true
# VITE_ENABLE_FAVORITES=true
# VITE_ENABLE_REMINDERS=true

# -------------------------------------------
# Environment
# -------------------------------------------
NODE_ENV=development

# ===========================================
# INSTRUCCIONES:
# ===========================================
# 1. Crea un proyecto en https://supabase.com
# 2. Copia la URL del proyecto y la anon key
# 3. Pega los valores en las variables de Supabase arriba
# 4. Ejecuta las migraciones: supabase migration up
# 5. Carga el seed si es desarrollo local: npx supabase db query --local -f supabase/seed.sql
# ===========================================