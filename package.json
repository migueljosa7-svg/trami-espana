{
  "name": "trami-espana",
  "version": "1.1.0",
  "private": true,
  "description": "Trami España - Aplicación para encontrar y entender trámites administrativos en España",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run dev --workspace=apps/mobile",
    "build": "npm run build --workspace=apps/web",
    "build:mobile": "npm run build --workspace=apps/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npx supabase migration up",
    "db:status": "npx supabase migration list",
    "postinstall": "node scripts/postinstall-expo-cli-win-fix.js",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "tramites",
    "espana",
    "administracion",
    "supabase",
    "react",
    "expo"
  ],
  "author": "Trami España",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.2",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "expo": "~50.0.17",
    "react": "18.2.0",
    "react-native": "0.73.6"
  }
}
