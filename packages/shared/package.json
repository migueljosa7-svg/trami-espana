{
    "name": "@trami-espana/shared",
    "version": "1.0.0",
    "private": true,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts"
        },
        "./utils/*": {
            "types": "./src/utils/*.ts",
            "import": "./src/utils/*.ts"
        },
        "./constants/*": {
            "types": "./src/constants/*.ts",
            "import": "./src/constants/*.ts"
        }
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.4.0",
        "@testing-library/react": "^14.2.0",
        "@testing-library/user-event": "^14.5.0",
        "@vitest/coverage-v8": "^1.4.0",
        "happy-dom": "^13.3.0",
        "jsdom": "^24.0.0",
        "lightningcss": "^1.33.0",
        "typescript": "^5.3.3",
        "vitest": "^1.4.0"
    }
}